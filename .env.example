# Copy to .env (never commit it). Generate distinct tokens, e.g. `openssl rand -hex 32`.
KNOWLEDGE_READ_TOKEN=
KNOWLEDGE_ADMIN_TOKEN=
# JSON list of explicitly authorized document IDs. Use ["*"] only for unrestricted access.
# Quote the wildcard inside the list: [*] is invalid. See doc/operations.md.
KNOWLEDGE_ALLOWED_DOCUMENTS='[]'
# Calibrate against the intended corpus and model before starting the server.
# This must also be forwarded in Compose's environment mapping; recreate after changes.
KNOWLEDGE_MIN_SCORE=

# Image build: extras to install (pdf = lexical search only) and the network used by the build.
# Set KNOWLEDGE_BUILD_NETWORK=host if the build fails with "Temporary failure in name resolution".
KNOWLEDGE_EXTRAS=pdf,vector
KNOWLEDGE_BUILD_NETWORK=default

# Host port bound on 127.0.0.1.
KNOWLEDGE_PORT=8080

# Semantic search: needs the image built with the vector extra and a model in KNOWLEDGE_MODELS_DIR.
KNOWLEDGE_EMBEDDINGS=false
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_MODELS_DIR=./models
