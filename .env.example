# Copy to .env (never commit it). Generate distinct tokens, e.g. `openssl rand -hex 32`.
KNOWLEDGE_READ_TOKEN=
KNOWLEDGE_ADMIN_TOKEN=

# Host port bound on 127.0.0.1.
KNOWLEDGE_PORT=8080

# Semantic search: needs the image built with the vector extra and a model in KNOWLEDGE_MODELS_DIR.
KNOWLEDGE_EMBEDDINGS=false
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_MODELS_DIR=./models
